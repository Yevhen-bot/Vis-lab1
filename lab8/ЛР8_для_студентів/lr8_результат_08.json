 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    candidates = rng.choice(len(F), size=k, replace=True)\n    best = candidates[np.argmin(F[candidates])]\n\n    return int(best)\n",
  "ox": "def ox(p1, p2, i, j):\n    n = len(p1)\n    child = [None] * n\n    child[i:j + 1] = p1[i:j + 1]\n    used = set(p1[i:j + 1])\n    pos = (j + 1) % n\n\n    for offset in range(n):\n        gene = p2[(j + 1 + offset) % n]\n        if gene in used:\n            continue\n        while child[pos] is not None:\n            pos = (pos + 1) % n\n        child[pos] = gene\n        used.add(gene)\n        pos = (pos + 1) % n\n\n    return np.array(child)\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    left = np.asarray(left, dtype=int)\n    weights = tau[cur, left] ** alpha * eta[cur, left] ** beta\n    probabilities = weights / weights.sum()\n\n    return rng.choice(left, p=probabilities)\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new_tau = tau.copy()\n    new_tau *= (1 - rho)\n\n    for tour, length in zip(tours, lens):\n        path = [0] + list(tour) + [0]\n        deposit = 1 / length\n\n        for i in range(len(path) - 1):\n            u = path[i]\n            v = path[i + 1]\n            new_tau[u, v] += deposit\n\n    return new_tau\n"
 },
